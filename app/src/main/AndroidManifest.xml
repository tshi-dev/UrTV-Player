<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Only exception to "INTERNET only": a normal, app-defined permission declared by the UrTV home app. No user prompt, and it
         grants nothing beyond one value (UrTV's language, ar or en). The queries line is Android 11+ package visibility. -->
    <uses-permission android:name="sa.urtv.permission.READ_LANG" />
    <queries><package android:name="sa.urtv.home" /><package android:name="sa.urtv.screensaver" /><provider android:authorities="sa.urtv.home.lang" /><provider android:authorities="sa.urtv.home.player" /></queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".UrtvApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security"
        android:usesCleartextTraffic="true"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/no_backup"
        android:theme="@style/Theme.Urtv">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Second exported component: «find the channel for this match», callable only by the UrTV home app or screensaver,
             verified in code by package name and signing certificate (the caller must use startActivityForResult). -->
        <activity
            android:name=".FindMatchActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Urtv.Overlay"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="sa.urtv.player.action.FIND_MATCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Only the launcher and FIND_MATCH activities are exported: drop the exported dev receiver that androidx.profileinstaller adds. -->
        <receiver android:name="androidx.profileinstaller.ProfileInstallReceiver" tools:node="remove" />
    </application>
</manifest>
